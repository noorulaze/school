rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        (request.auth.token.email != null && (
          request.auth.token.email.matches('.*admin.*') ||
          request.auth.token.email == 'admin@sharafiyya.edu'
        ))
      );
    }
    
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // 1. Schools (Institutional metadata)
    match /schools/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. Notices & Updates (Published notices can be read; drafts & management restricted to admin)
    match /notices/{noticeId} {
      allow read: if (resource.data.published == true && 
                      (resource.data.targetAudience in ['Everyone', 'Parents'] || !('targetAudience' in resource.data)))
                  || (isAuthenticated() && resource.data.published == true)
                  || isAdmin();
      allow write: if isAdmin();
    }

    // 3. Events & Programs (Published events can be viewed by public; write restricted to admin)
    match /events/{eventId} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    // 4. Teachers & Faculty
    match /teachers/{teacherId} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    // 5. Academic Departments
    match /departments/{deptId} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    // 6. Photo Gallery
    match /gallery/{imageId} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    // 7. Admission Enquiries (Public can only create with status 'New'; only admin can read, update, delete)
    match /admissions/{enquiryId} {
      allow create: if request.resource.data.applicantName is string
                    && request.resource.data.phone is string
                    && request.resource.data.enquiryType is string
                    && (request.resource.data.status == 'New' || !('status' in request.resource.data));
      allow read, update, delete: if isAdmin();
    }

    // 8. Students (Strict UID isolation: student can only read their own record; admin can manage)
    match /students/{studentId} {
      allow read: if isOwner(studentId) || isOwner(resource.data.uid) || isAdmin();
      allow write: if isAdmin();
    }

    // 9. Attendance
    match /attendance/{attendanceId} {
      allow read: if isOwner(resource.data.uid) || isAdmin();
      allow write: if isAdmin();
    }

    // 10. Academic Records
    match /academicRecords/{recordId} {
      allow read: if isOwner(resource.data.uid) || isAdmin();
      allow write: if isAdmin();
    }

    // 11. Student Documents (Private to the student owner and admin)
    match /studentDocuments/{documentId} {
      allow read: if isOwner(resource.data.uid) || isAdmin();
      allow write: if isAdmin();
    }
  }
}